# Every value here has a working default. This file is optional: with no .env
# and no API key the project still ingests, retrieves and writes reports.

# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# auto   = use OpenAI when OPENAI_API_KEY is set, otherwise the local providers
# openai = force OpenAI
# local  = force the local providers even if a key is present
PROVIDER_MODE=auto

# Named backends from the registry in src/providers. "auto" follows
# PROVIDER_MODE; anything else selects a registered provider by name, including
# one a downstream project registered itself.
LLM_PROVIDER=auto              # auto | openai | local
EMBEDDING_PROVIDER=auto        # auto | openai | local | hashing
VECTOR_BACKEND=chroma          # chroma | memory

# ---------------------------------------------------------------------------
# OpenAI. Leave OPENAI_API_KEY unset to run entirely offline.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_REQUEST_TIMEOUT=60
OPENAI_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Offline providers
# ---------------------------------------------------------------------------
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Width of the model-free embedder used by scripts/benchmark.py and the tests.
HASHING_DIMENSIONS=256

# ---------------------------------------------------------------------------
# Embedding cache. Embeddings are a pure function of (model, text), so a repeat
# is pure waste. The key includes the model name, so one backend's vectors can
# never be served to another.
# ---------------------------------------------------------------------------
ENABLE_EMBEDDING_CACHE=true
EMBEDDING_CACHE_PATH=./data/embedding_cache.sqlite

# ---------------------------------------------------------------------------
# Vector store
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=company_data

# ---------------------------------------------------------------------------
# Chunking and retrieval
# ---------------------------------------------------------------------------
# CHUNK_OVERLAP must be smaller than CHUNK_SIZE; the app refuses to start
# otherwise, rather than failing obscurely at ingestion time.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ---------------------------------------------------------------------------
# Context assembly. This is where the money goes: every character here is
# billed as an input token on every query.
# ---------------------------------------------------------------------------
# Hard cap on the context assembled into a single prompt.
MAX_CONTEXT_CHARS=12000
# Drop retrieved chunks whose distance from the query is worse than the best
# hit by more than this fraction. 0 keeps everything retrieval returned.
CONTEXT_RELEVANCE_MARGIN=0.35

# ---------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------
MAX_REPORT_LENGTH=2000
REPORT_OUTPUT_DIR=./reports

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
APP_NAME=RAG Company Report Generator
APP_VERSION=1.0.0
ENABLE_COST_TRACKING=true
COST_LOG_FILE=./logs/cost_tracking.json
LOG_LEVEL=INFO
ENVIRONMENT=development        # "production" switches logs to JSON
LOG_DIR=./logs
LOG_FILE=app.log
LOG_ROTATION_SIZE_MB=10
LOG_BACKUP_COUNT=5

# ---------------------------------------------------------------------------
# Local API server. 8350 rather than 8000, which collides with everything.
# ---------------------------------------------------------------------------
PORT=8350
