# Keep the build context small and the image reproducible.
#
# Without this file `COPY . .` pulled in whatever the developer happened to
# have locally: a virtualenv of the wrong Python, a Chroma index built by the
# other embedding backend, and the whole git history.

.git
.gitignore
.dockerignore

# Virtualenvs - the image builds its own in /opt/venv
venv/
env/
ENV/
.venv/
project_venv/

# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Local state. data/raw_data is deliberately NOT excluded: the container
# ingests it at startup.
data/chroma_db/
data/hf/
logs/
reports/
*.log

# Secrets never belong in an image layer
.env

# Local throwaways
README.preview.html
.DS_Store
.idea/
.vscode/
